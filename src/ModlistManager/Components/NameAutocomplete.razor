@* Free-text input with as-you-type suggestions drawn from existing requester names.

   Deliberately not MudAutocomplete: the suggestion list must never block a plain form POST, so the
   underlying element stays a real named input, and the dropdown items use onmousedown with
   preventDefault so the input doesn't blur before the click registers. *@

<div class="name-autocomplete">
    <MudTextField T="string"
                  Value="@Value"
                  ValueChanged="OnValueChangedAsync"
                  Immediate="true"
                  Label="@Label"
                  Placeholder="@Placeholder"
                  Variant="Variant.Outlined"
                  OnBlur="@(() => _showSuggestions = false)"
                  name="@Name"
                  id="@Id"
                  autocomplete="off" />

    @if (_showSuggestions && _filtered.Count > 0)
    {
        <MudPaper Elevation="4" Class="name-autocomplete-list">
            @foreach (var suggestion in _filtered)
            {
                <div class="name-autocomplete-item"
                     @onmousedown="() => SelectSuggestionAsync(suggestion)"
                     @onmousedown:preventDefault="true">
                    @suggestion
                </div>
            }
        </MudPaper>
    }
</div>

@code {
    private List<string> _filtered = [];
    private bool _showSuggestions;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public IReadOnlyList<string> Suggestions { get; set; } = [];

    /// <summary>The "name" attribute on the underlying input, so it's included in a native form POST.</summary>
    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    private async Task OnValueChangedAsync(string? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(Value);
        Filter();
        _showSuggestions = true;
    }

    private async Task SelectSuggestionAsync(string suggestion)
    {
        Value = suggestion;
        await ValueChanged.InvokeAsync(Value);
        _showSuggestions = false;
    }

    private void Filter()
    {
        var input = Value?.Trim() ?? string.Empty;
        _filtered = (input.Length == 0
                ? Suggestions
                : Suggestions.Where(s => s.Contains(input, StringComparison.OrdinalIgnoreCase)))
            .Where(s => !string.Equals(s, input, StringComparison.OrdinalIgnoreCase))
            .Take(8)
            .ToList();
    }
}
