@page "/"
@rendermode InteractiveServer
@using ModlistManager.Data.Entities
@using ModlistManager.Services
@inject ModRequestService ModRequestService
@implements IAsyncDisposable

<PageTitle>Project Zomboid Mod Requests</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Project Zomboid Mod Requests</MudText>
<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
    Request a Steam Workshop mod for the server. An admin will review it.
</MudText>

<MudCard Elevation="2" Class="mb-8">
    <MudCardContent>
        <MudText Typo="Typo.h6" GutterBottom="true">New request</MudText>

        @if (Error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@Error</MudAlert>
        }

        @* Plain HTML form posting to a minimal API endpoint - deliberately not an EditForm, so
           creating a request never depends on the interactive circuit having connected. The fields
           are still bound so typing in one (which re-renders this component) doesn't wipe the others. *@
        <form method="post" action="/requests">
            <MudTextField T="string" @bind-Value="_title" Immediate="true"
                          Label="Title" Variant="Variant.Outlined" Class="mb-4"
                          name="title" id="title" />

            <MudTextField T="string" @bind-Value="_workshopInput" Immediate="true"
                          Label="Steam Workshop link or item ID" Variant="Variant.Outlined"
                          Placeholder="https://steamcommunity.com/sharedfiles/filedetails/?id=3783094058"
                          OnBlur="CheckForDuplicateAsync"
                          name="workshopInput" id="workshop" />

            @if (_existingRequests.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2 mb-4">
                    <MudText Typo="Typo.body2">
                        <strong>Already requested.</strong>
                        @if (_existingRequests[0].ModTitle is { Length: > 0 } modTitle)
                        {
                            <text> This is <em>@modTitle</em>.</text>
                        }
                    </MudText>
                    @foreach (var existing in _existingRequests)
                    {
                        <MudText Typo="Typo.body2">
                            &ldquo;@existing.Title&rdquo; by @existing.RequesterName
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(existing.Status)">@existing.Status</MudChip>
                        </MudText>
                    }
                    <MudText Typo="Typo.caption">
                        You can still submit &mdash; it will be added as another vote for the same mod.
                    </MudText>
                </MudAlert>
            }
            else
            {
                <div class="mb-4"></div>
            }

            <div class="mb-4">
                <NameAutocomplete Id="name" Name="requesterName" Label="Your name"
                                  @bind-Value="_requesterName" Suggestions="_nameSuggestions" />
            </div>

            <MudTextField T="string" @bind-Value="_reason" Immediate="true"
                          Label="Why do we need it? (optional)" Variant="Variant.Outlined"
                          Lines="3" Class="mb-4"
                          Placeholder="What does this mod add, and why is it worth having on the server?"
                          name="reason" id="reason" />

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                Submit request
            </MudButton>
        </form>
    </MudCardContent>
</MudCard>

<MudText Typo="Typo.h6">Pending requests</MudText>
<MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
    Waiting on an admin decision. Approved mods appear on the <MudLink Href="modlist">modlist</MudLink>.
</MudText>

@if (_pendingRequests is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_pendingRequests.Count == 0)
{
    <MudAlert Severity="Severity.Normal" Dense="true">Nothing pending right now.</MudAlert>
}
else
{
    <MudTable Items="_pendingRequests" Dense="true" Hover="true" Elevation="1" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Mod</MudTh>
            <MudTh>Requested by</MudTh>
            <MudTh>Reason</MudTh>
            <MudTh>Mod ID</MudTh>
            <MudTh>Submitted</MudTh>
        </HeaderContent>
        <RowTemplate Context="request">
            <MudTd DataLabel="Mod">
                <MudLink Href="@WorkshopUrl(request.Mod!.WorkshopId)" Target="_blank">@request.Title</MudLink>
                @if (request.Mod!.Title is { Length: > 0 } workshopTitle
                     && !string.Equals(workshopTitle, request.Title, StringComparison.OrdinalIgnoreCase))
                {
                    <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">@workshopTitle</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Requested by">@request.RequesterName</MudTd>
            <MudTd DataLabel="Reason">
                <MudText Typo="Typo.body2">@request.Reason</MudText>
            </MudTd>
            <MudTd DataLabel="Mod ID">
                @if (request.Mod!.PzModIds.Count > 0)
                {
                    <MudText Typo="Typo.body2" Class="font-monospace">
                        @string.Join(", ", request.Mod!.PzModIds.Select(m => m.Value))
                    </MudText>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="@FetchColor(request.Mod!.FetchStatus)">
                        @request.Mod!.FetchStatus
                    </MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Submitted">
                <MudText Typo="Typo.caption">@request.CreatedAtUtc.ToLocalTime().ToString("g")</MudText>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string _title = string.Empty;
    private string _workshopInput = string.Empty;
    private string _reason = string.Empty;
    private string? _requesterName;
    private List<ModRequest>? _pendingRequests;
    private List<string> _nameSuggestions = [];
    private List<ModRequestService.ExistingRequestInfo> _existingRequests = [];
    private CancellationTokenSource? _pollCts;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _pollCts = new CancellationTokenSource();
        _ = PollWhilePendingAsync(_pollCts.Token);
    }

    private async Task RefreshAsync()
    {
        _pendingRequests = await ModRequestService.GetRequestsAsync(RequestStatus.Pending);
        _nameSuggestions = await ModRequestService.GetDistinctRequesterNamesAsync();
    }

    private async Task CheckForDuplicateAsync()
    {
        _existingRequests = await ModRequestService.FindExistingRequestsAsync(_workshopInput);
    }

    private async Task PollWhilePendingAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
        while (await timer.WaitForNextTickAsync(token))
        {
            if (_pendingRequests is null
                || _pendingRequests.All(r => r.Mod!.FetchStatus is ModIdFetchStatus.Completed or ModIdFetchStatus.Failed))
            {
                continue;
            }

            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string WorkshopUrl(string workshopId) =>
        $"https://steamcommunity.com/sharedfiles/filedetails/?id={workshopId}";

    private static Color StatusColor(RequestStatus status) => status switch
    {
        RequestStatus.Approved => Color.Success,
        RequestStatus.Backlogged => Color.Warning,
        RequestStatus.Declined => Color.Error,
        _ => Color.Default
    };

    private static Color FetchColor(ModIdFetchStatus status) => status switch
    {
        ModIdFetchStatus.Completed => Color.Success,
        ModIdFetchStatus.Processing => Color.Info,
        ModIdFetchStatus.Failed => Color.Error,
        _ => Color.Default
    };

    public async ValueTask DisposeAsync()
    {
        if (_pollCts is not null)
        {
            await _pollCts.CancelAsync();
            _pollCts.Dispose();
        }
    }
}
