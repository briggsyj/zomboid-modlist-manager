@page "/"
@rendermode InteractiveServer
@using ModlistManager.Data.Entities
@using ModlistManager.Services
@inject ModRequestService ModRequestService
@implements IAsyncDisposable

<PageTitle>Project Zomboid Mod Requests</PageTitle>

<h1>Project Zomboid Mod Requests</h1>
<p class="text-muted">Request a Steam Workshop mod for the server. An admin will review it.</p>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">New request</h2>

        @if (Error is not null)
        {
            <div class="alert alert-danger">@Error</div>
        }

        @* Plain HTML form posting to a minimal API endpoint - deliberately not an EditForm/OnValidSubmit,
           so creating a request never depends on the interactive SignalR circuit having connected.
           Title/workshop are still @bind'd (not just plain inputs) so that typing in the interactive
           NameAutocomplete below - which re-renders this component - doesn't wipe them back to empty;
           Blazor only preserves a native input's value across re-renders once it's tracking it itself. *@
        <form method="post" action="/requests">
            <div class="mb-3">
                <label class="form-label" for="title">Title</label>
                <input id="title" name="title" class="form-control" @bind="_title" @bind:event="oninput" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="workshop">Steam Workshop link or item ID</label>
                <input id="workshop" name="workshopInput" class="form-control" placeholder="https://steamcommunity.com/sharedfiles/filedetails/?id=3783094058"
                       @bind="_workshopInput" @bind:event="oninput" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="name">Your name</label>
                <NameAutocomplete Id="name" Name="requesterName" Suggestions="_nameSuggestions" Placeholder="Your name" />
            </div>
            <button type="submit" class="btn btn-primary">Submit request</button>
        </form>
    </div>
</div>

<h2 class="h5">All requests</h2>

@if (_requests is null)
{
    <p><em>Loading...</em></p>
}
else if (_requests.Count == 0)
{
    <p><em>No requests yet.</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Game</th>
                    <th>Workshop item</th>
                    <th>Requested by</th>
                    <th>Status</th>
                    <th>Mod ID lookup</th>
                    <th>Submitted</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in _requests)
                {
                    <tr>
                        <td>@request.Title</td>
                        <td>@request.Mod!.Game</td>
                        <td><a href="https://steamcommunity.com/sharedfiles/filedetails/?id=@request.Mod!.WorkshopId" target="_blank" rel="noopener noreferrer">@request.Mod!.WorkshopId</a></td>
                        <td>@request.RequesterName</td>
                        <td><span class="badge @StatusBadgeClass(request.Status)">@request.Status</span></td>
                        <td>
                            <span class="badge @FetchStatusBadgeClass(request.Mod!.FetchStatus)">@request.Mod!.FetchStatus</span>
                            @if (request.Mod!.PzModIds.Count > 0)
                            {
                                <div class="small text-muted">@string.Join(", ", request.Mod!.PzModIds.Select(m => m.Value))</div>
                            }
                        </td>
                        <td>@request.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string _title = string.Empty;
    private string _workshopInput = string.Empty;
    private List<ModRequest>? _requests;
    private List<string> _nameSuggestions = [];
    private CancellationTokenSource? _pollCts;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _pollCts = new CancellationTokenSource();
        _ = PollWhilePendingAsync(_pollCts.Token);
    }

    private async Task RefreshAsync()
    {
        _requests = await ModRequestService.GetRequestsAsync();
        _nameSuggestions = await ModRequestService.GetDistinctRequesterNamesAsync();
    }

    private async Task PollWhilePendingAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
        while (await timer.WaitForNextTickAsync(token))
        {
            if (_requests is null || _requests.All(r => r.Mod!.FetchStatus is ModIdFetchStatus.Completed or ModIdFetchStatus.Failed))
            {
                continue;
            }

            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string StatusBadgeClass(RequestStatus status) => status switch
    {
        RequestStatus.Approved => "bg-success",
        RequestStatus.Backlogged => "bg-warning text-dark",
        RequestStatus.Declined => "bg-danger",
        _ => "bg-secondary"
    };

    private static string FetchStatusBadgeClass(ModIdFetchStatus status) => status switch
    {
        ModIdFetchStatus.Completed => "bg-success",
        ModIdFetchStatus.Processing => "bg-info text-dark",
        ModIdFetchStatus.Failed => "bg-danger",
        _ => "bg-secondary"
    };

    public async ValueTask DisposeAsync()
    {
        if (_pollCts is not null)
        {
            await _pollCts.CancelAsync();
            _pollCts.Dispose();
        }
    }
}
