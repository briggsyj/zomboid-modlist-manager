@page "/"
@rendermode InteractiveServer
@using ModlistManager.Data.Entities
@using ModlistManager.Services
@inject ModRequestService ModRequestService
@inject SteamWorkshopApiClient WorkshopApi
@implements IAsyncDisposable

<PageTitle>Project Zomboid Mod Requests</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Project Zomboid Mod Requests</MudText>
<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
    Request a Steam Workshop mod for the server. An admin will review it.
</MudText>

<MudCard Elevation="2" Class="mb-8">
    <MudCardContent>
        <MudText Typo="Typo.h6" GutterBottom="true">New request</MudText>

        @if (Error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@Error</MudAlert>
        }

        @* Plain HTML form posting to a minimal API endpoint - deliberately not an EditForm, so
           creating a request never depends on the interactive circuit having connected. The fields
           are still bound so typing in one (which re-renders this component) doesn't wipe the others. *@
        <form method="post" action="/requests">
            @* No title field: the mod's name is taken from the workshop item itself. It's previewed
               below as soon as a link is entered, so the requester can confirm they pasted the right one. *@
            <MudTextField T="string" @bind-Value="_workshopInput" Immediate="true"
                          Label="Steam Workshop link or item ID" Variant="Variant.Outlined"
                          Placeholder="https://steamcommunity.com/sharedfiles/filedetails/?id=3783094058"
                          OnBlur="LookUpWorkshopItemAsync"
                          name="workshopInput" id="workshop" />

            @if (_lookingUp)
            {
                <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">Looking up mod&hellip;</MudText>
            }
            else if (_resolvedTitle is { Length: > 0 } resolved)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2" Icon="@Icons.Material.Filled.Check">
                    @resolved
                </MudAlert>
            }
            else if (_lookupFailed)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                    Couldn't find that item on the Steam Workshop. Double-check the link &mdash; you can still
                    submit, and an admin will take a look.
                </MudAlert>
            }

            @if (_existingRequests.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2 mb-4">
                    <MudText Typo="Typo.body2">
                        <strong>Already requested.</strong>
                        @if (_existingRequests[0].ModTitle is { Length: > 0 } modTitle)
                        {
                            <text> This is <em>@modTitle</em>.</text>
                        }
                    </MudText>
                    @foreach (var existing in _existingRequests)
                    {
                        <MudText Typo="Typo.body2">
                            Requested by @existing.RequesterName
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(existing.Status)">@existing.Status</MudChip>
                        </MudText>
                    }
                    <MudText Typo="Typo.caption">
                        You can still submit &mdash; it will be added as another vote for the same mod.
                    </MudText>
                </MudAlert>
            }
            else
            {
                <div class="mb-4"></div>
            }

            <div class="mb-4">
                <NameAutocomplete Id="name" Name="requesterName" Label="Your name"
                                  @bind-Value="_requesterName" Suggestions="_nameSuggestions" />
            </div>

            <MudTextField T="string" @bind-Value="_reason" Immediate="true"
                          Label="Why do we need it? (optional)" Variant="Variant.Outlined"
                          Lines="3" Class="mb-4"
                          Placeholder="What does this mod add, and why is it worth having on the server?"
                          name="reason" id="reason" />

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                Submit request
            </MudButton>
        </form>
    </MudCardContent>
</MudCard>

@if (_pendingRequests is null || _backloggedRequests is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudText Typo="Typo.h6">Pending requests</MudText>
    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
        Waiting for review. Approved mods appear under <MudLink Href="modlist">Active Mods</MudLink>.
    </MudText>

    <RequestsTable Requests="_pendingRequests" EmptyMessage="Nothing pending right now." />

    <MudText Typo="Typo.h6" Class="mt-8">Backlog</MudText>
    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
        Reviewed and kept for later &mdash; not turned down, just not going on the server yet.
    </MudText>

    <RequestsTable Requests="_backloggedRequests" EmptyMessage="Nothing in the backlog." />
}

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string _workshopInput = string.Empty;
    private string _reason = string.Empty;
    private string? _requesterName;
    private string? _resolvedTitle;
    private string? _lastLookedUpId;
    private bool _lookingUp;
    private bool _lookupFailed;
    private List<ModRequest>? _pendingRequests;
    private List<ModRequest>? _backloggedRequests;
    private List<string> _nameSuggestions = [];
    private List<ModRequestService.ExistingRequestInfo> _existingRequests = [];
    private CancellationTokenSource? _pollCts;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _pollCts = new CancellationTokenSource();
        _ = PollWhilePendingAsync(_pollCts.Token);
    }

    private async Task RefreshAsync()
    {
        // One query for both sections, split in memory, rather than a round trip per status.
        var open = await ModRequestService.GetRequestsByStatusAsync(RequestStatus.Pending, RequestStatus.Backlogged);
        _pendingRequests = open.Where(r => r.Status == RequestStatus.Pending).ToList();
        _backloggedRequests = open.Where(r => r.Status == RequestStatus.Backlogged).ToList();
        _nameSuggestions = await ModRequestService.GetDistinctRequesterNamesAsync();
    }

    /// <summary>
    /// Resolves the workshop item's title for preview and checks whether it's already been
    /// requested. Runs on blur rather than per-keystroke so pasting a link is a single lookup.
    /// </summary>
    private async Task LookUpWorkshopItemAsync()
    {
        var workshopId = WorkshopIdParser.TryParse(_workshopInput);
        if (workshopId is null)
        {
            _resolvedTitle = null;
            _lastLookedUpId = null;
            _lookupFailed = false;
            _existingRequests = [];
            return;
        }

        _existingRequests = await ModRequestService.FindExistingRequestsAsync(_workshopInput);

        // Skip the network round trip if this is the same item we already resolved.
        if (workshopId == _lastLookedUpId)
        {
            return;
        }

        _lookingUp = true;
        _resolvedTitle = null;
        _lookupFailed = false;
        StateHasChanged();

        try
        {
            var item = await WorkshopApi.GetItemAsync(workshopId);
            _resolvedTitle = item?.Title;
            _lookupFailed = item is null;
            _lastLookedUpId = workshopId;
        }
        finally
        {
            _lookingUp = false;
        }
    }

    private async Task PollWhilePendingAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
        while (await timer.WaitForNextTickAsync(token))
        {
            var shown = (_pendingRequests ?? []).Concat(_backloggedRequests ?? []);
            if (shown.All(r => r.Mod!.FetchStatus is ModIdFetchStatus.Completed or ModIdFetchStatus.Failed))
            {
                continue;
            }

            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private static Color StatusColor(RequestStatus status) => status switch
    {
        RequestStatus.Approved => Color.Success,
        RequestStatus.Backlogged => Color.Warning,
        RequestStatus.Declined => Color.Error,
        _ => Color.Default
    };

    public async ValueTask DisposeAsync()
    {
        if (_pollCts is not null)
        {
            await _pollCts.CancelAsync();
            _pollCts.Dispose();
        }
    }
}
