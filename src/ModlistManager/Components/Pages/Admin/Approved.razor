@page "/admin/approved"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ModlistManager.Data.Entities
@using ModlistManager.Services
@inject ModRequestService ModRequestService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Admin - Modlist</PageTitle>

<h1>Modlist</h1>

<div class="mb-3 col-md-4">
    <label class="form-label" for="game">Game</label>
    <select id="game" class="form-select" value="@_selectedGame" @onchange="OnGameChangedAsync">
        @foreach (var game in _games)
        {
            <option value="@game">@game</option>
        }
    </select>
</div>

<div class="mb-4 d-flex gap-2 align-items-center flex-wrap">
    <button type="button" class="btn btn-primary" @onclick="CopyWorkshopIdsAsync">
        Copy Workshop IDs (all games)
    </button>
    <button type="button" class="btn btn-primary" @onclick="CopyZomboidModIdsAsync">
        Copy Zomboid Mod IDs (\-prefixed)
    </button>
    @if (_copiedMessage is not null)
    {
        <span class="text-success">@_copiedMessage</span>
    }
</div>

@if (_mods is null)
{
    <p><em>Loading...</em></p>
}
else if (_mods.Count == 0)
{
    <p><em>No mods on the @_selectedGame modlist yet.</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Workshop item</th>
                    <th>Mod IDs</th>
                    <th>Requested by</th>
                    <th>Added to modlist</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mod in _mods)
                {
                    <tr>
                        <td><a href="https://steamcommunity.com/sharedfiles/filedetails/?id=@mod.WorkshopId" target="_blank" rel="noopener noreferrer">@mod.WorkshopId</a></td>
                        <td>@string.Join(", ", mod.PzModIds.Select(m => m.Value))</td>
                        <td>@string.Join(", ", mod.Requests.Select(r => r.RequesterName).Distinct())</td>
                        <td>@(mod.AddedToModlistAtUtc?.ToLocalTime().ToString("g"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<string> _games = [Mod.DefaultGame];
    private string _selectedGame = Mod.DefaultGame;
    private List<Mod>? _mods;
    private string? _copiedMessage;
    private IJSObjectReference? _clipboardModule;

    protected override async Task OnInitializedAsync()
    {
        var distinctGames = await ModRequestService.GetDistinctGamesAsync();
        if (distinctGames.Count > 0)
        {
            _games = distinctGames;
            if (!_games.Contains(_selectedGame))
            {
                _selectedGame = _games[0];
            }
        }

        await RefreshAsync();
    }

    private async Task<IJSObjectReference> GetClipboardModuleAsync() =>
        _clipboardModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/clipboard.js");

    private async Task RefreshAsync()
    {
        _mods = await ModRequestService.GetModlistAsync(_selectedGame);
    }

    private async Task OnGameChangedAsync(ChangeEventArgs e)
    {
        _selectedGame = e.Value?.ToString() ?? Mod.DefaultGame;
        _copiedMessage = null;
        await RefreshAsync();
    }

    private async Task CopyWorkshopIdsAsync()
    {
        var ids = await ModRequestService.BuildApprovedWorkshopIdExportAsync();
        var module = await GetClipboardModuleAsync();
        await module.InvokeVoidAsync("copyToClipboard", ids);
        _copiedMessage = string.IsNullOrEmpty(ids) ? "No mods on the modlist to copy." : "Copied!";
    }

    private async Task CopyZomboidModIdsAsync()
    {
        var ids = await ModRequestService.BuildApprovedZomboidModIdExportAsync();
        var module = await GetClipboardModuleAsync();
        await module.InvokeVoidAsync("copyToClipboard", ids);
        _copiedMessage = string.IsNullOrEmpty(ids) ? "No approved Zomboid mod IDs to copy." : "Copied!";
    }

    public async ValueTask DisposeAsync()
    {
        if (_clipboardModule is not null)
        {
            await _clipboardModule.DisposeAsync();
        }
    }
}
