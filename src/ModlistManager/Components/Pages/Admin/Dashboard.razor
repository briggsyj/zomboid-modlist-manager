@* /admin is kept alongside the renamed route so existing links and bookmarks still resolve. *@
@page "/manage"
@page "/admin"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ModlistManager.Data.Entities
@using ModlistManager.Services
@inject ModRequestService ModRequestService
@implements IAsyncDisposable

<PageTitle>Manage - Requests</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Manage</MudText>
<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
    Drag a request between columns to change its state. Dropping into <em>Approved</em> adds the mod
    to <MudLink Href="active-mods">Active Mods</MudLink>; the order of cards here has no bearing on the
    server's load order, which is set by dragging on that page.
</MudText>

@if (_requests is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudDropContainer T="ModRequest" @ref="_dropContainer" Items="_requests"
                      ItemsSelector="@((request, zone) => request.Status.ToString() == zone)"
                      ItemDropped="OnRequestDroppedAsync">
        <ChildContent>
            <MudGrid Spacing="3">
                @foreach (var column in Columns)
                {
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Elevation="1" Class="pa-3 kanban-column">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                                <MudText Typo="Typo.subtitle1">@column.Label</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@column.Color">
                                    @_requests.Count(r => r.Status == column.Status)
                                </MudChip>
                            </MudStack>

                            @* No AllowReorder: position within a column carries no meaning, and
                               letting people rearrange cards would imply it does. *@
                            <MudDropZone T="ModRequest" Identifier="@column.Status.ToString()"
                                         Class="kanban-dropzone" />
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </ChildContent>

        <ItemRenderer>
            <MudCard Elevation="2" Class="mb-2 kanban-card">
                <MudCardContent Class="pa-3">
                    <MudLink Href="@WorkshopUrl(context.Mod!.WorkshopId)" Target="_blank" Typo="Typo.body1">
                        @context.Mod!.DisplayName
                    </MudLink>
                    <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">
                        Requested by @context.RequesterName
                    </MudText>

                    <MudExpansionPanels Elevation="0" Dense="true" Class="mt-2">
                        <MudExpansionPanel Text="Details">
                            @if (!string.IsNullOrWhiteSpace(context.Reason))
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Reason</MudText>
                                <MudText Typo="Typo.body2" Class="mb-2">@context.Reason</MudText>
                            }

                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Mod IDs</MudText>
                            @if (context.Mod!.PzModIds.Count == 0)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudChip T="string" Size="Size.Small" Color="@FetchColor(context.Mod!.FetchStatus)">
                                        @context.Mod!.FetchStatus
                                    </MudChip>
                                    @if (context.Mod!.FetchStatus == ModIdFetchStatus.Failed)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                                   OnClick="@(() => RetryFetchAsync(context.Mod!.Id))">
                                            Retry
                                        </MudButton>
                                    }
                                </MudStack>
                                @if (!string.IsNullOrWhiteSpace(context.Mod!.FetchLog))
                                {
                                    <MudText Typo="Typo.caption" Class="d-block mud-text-secondary mt-1"
                                             Style="white-space: pre-wrap;">@context.Mod!.FetchLog</MudText>
                                }
                            }
                            else
                            {
                                @* Read-only here; Mod IDs are edited on Active Mods. *@
                                @foreach (var pzModId in context.Mod!.PzModIds.OrderBy(p => p.Id))
                                {
                                    <MudText Typo="Typo.body2"
                                             Class="@($"font-monospace {(pzModId.IsEnabled ? "" : "mud-text-disabled")}")">
                                        @pzModId.Value
                                    </MudText>
                                }
                            }
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudCardContent>
            </MudCard>
        </ItemRenderer>
    </MudDropContainer>
}

@code {
    private sealed record Column(RequestStatus Status, string Label, Color Color);

    private static readonly Column[] Columns =
    [
        new(RequestStatus.Pending, "Pending", Color.Default),
        new(RequestStatus.Backlogged, "Backlog", Color.Warning),
        new(RequestStatus.Approved, "Approved", Color.Success),
        new(RequestStatus.Declined, "Declined", Color.Error)
    ];

    private List<ModRequest>? _requests;
    private MudDropContainer<ModRequest>? _dropContainer;
    private CancellationTokenSource? _pollCts;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _pollCts = new CancellationTokenSource();
        _ = PollWhileFetchingAsync(_pollCts.Token);
    }

    private async Task RefreshAsync()
    {
        _requests = await ModRequestService.GetRequestsAsync();
        _dropContainer?.Refresh();
    }

    /// <summary>
    /// Moving a card between columns is the only thing that changes a request's state. Dropping it
    /// back where it started is deliberately a no-op, so it doesn't restamp the decision time - and
    /// nothing here touches the modlist ordering, which belongs to the Active Mods page.
    /// </summary>
    private async Task OnRequestDroppedAsync(MudItemDropInfo<ModRequest> dropInfo)
    {
        if (dropInfo.Item is not { } request
            || !Enum.TryParse<RequestStatus>(dropInfo.DropzoneIdentifier, out var newStatus)
            || request.Status == newStatus)
        {
            return;
        }

        request.Status = newStatus;
        await ModRequestService.SetStatusAsync(request.Id, newStatus);
        _dropContainer?.Refresh();
    }

    private async Task RetryFetchAsync(int modId)
    {
        await ModRequestService.RetryFetchAsync(modId);
        await RefreshAsync();
    }

    // Fetches run in the background, so keep refreshing while any are still in flight.
    private async Task PollWhileFetchingAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
        while (await timer.WaitForNextTickAsync(token))
        {
            if (_requests is null
                || _requests.All(r => r.Mod!.FetchStatus is ModIdFetchStatus.Completed or ModIdFetchStatus.Failed))
            {
                continue;
            }

            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string WorkshopUrl(string workshopId) =>
        $"https://steamcommunity.com/sharedfiles/filedetails/?id={workshopId}";

    private static Color FetchColor(ModIdFetchStatus status) => status switch
    {
        ModIdFetchStatus.Completed => Color.Success,
        ModIdFetchStatus.Processing => Color.Info,
        ModIdFetchStatus.Failed => Color.Error,
        _ => Color.Default
    };

    public async ValueTask DisposeAsync()
    {
        if (_pollCts is not null)
        {
            await _pollCts.CancelAsync();
            _pollCts.Dispose();
        }
    }
}
