@* /modlist is kept alongside the renamed route so existing links and bookmarks still resolve. *@
@page "/active-mods"
@page "/modlist"
@using ModlistManager.Data.Entities
@using ModlistManager.Services
@inject ModRequestService ModRequestService
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Public page, in two lists: what the server is loading, and what's approved but switched off.
   The exports are public too. Admins additionally get the Active toggles, the details panels and
   drag-reordering. *@

<PageTitle>Active Mods</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Active Mods</MudText>
<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
    Mods currently running on the server. Want something added? <MudLink Href="/">Make a request</MudLink>.
</MudText>

@* Game picker on the left, exports pushed to the right on the same line. *@
<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4 flex-wrap">
    <MudSelect T="string" Value="_selectedGame" ValueChanged="OnGameChangedAsync" Label="Game"
               Variant="Variant.Outlined" Dense="true" Style="max-width: 22rem;">
        @foreach (var game in _games)
        {
            <MudSelectItem T="string" Value="@game">@game</MudSelectItem>
        }
    </MudSelect>

    <MudSpacer />

    @* Exports are public: the lists themselves already are, and players copy them into their own
       clients. Editing the modlist stays admin-only. *@
    @if (_copiedMessage is not null)
    {
        <MudText Typo="Typo.body2" Color="@(_copyFailed ? Color.Error : Color.Success)">@_copiedMessage</MudText>
    }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CopyWorkshopIdsAsync">
        Copy Workshop IDs
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CopyZomboidModIdsAsync">
        Copy Zomboid Mod IDs
    </MudButton>
</MudStack>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.caption" Class="d-block mb-4 mud-text-secondary">
            Unticking <em>Active</em> moves a mod to <em>Temporarily disabled</em> below: it stays in the
            Workshop IDs export so the server still downloads it, but drops out of the Zomboid Mod IDs
            export so it isn't loaded. Drag rows to set the load order.
        </MudText>
    </Authorized>
</AuthorizeView>

@* One table definition for both lists. Only the active list is drag-reorderable - load order is
   what dragging sets, and a disabled mod isn't in that order. *@
@{
    RenderFragment<(List<Mod> Mods, bool AllowDrag)> modTable = ctx =>
    @<div class="modlist-scroll">
        @* MudSimpleTable rather than MudTable so the <tr> elements are ours to attach drag handlers
           to; MudTable renders its own rows and won't pass arbitrary attributes through. *@
        <MudSimpleTable Hover="true" Dense="true" Elevation="1">
            <thead>
                <tr>
                    @if (_isAdmin)
                    {
                        <th style="width: 2.5rem;"></th>
                        <th>Active</th>
                    }
                    <th>Mod</th>
                    <th>Mod ID</th>
                    @* Who asked for a mod is admin business; visitors just see what's running. *@
                    @if (_isAdmin)
                    {
                        <th>Requested by</th>
                    }
                    <th>Added</th>
                    @if (_isAdmin)
                    {
                        @* Unlabelled: the expander speaks for itself. *@
                        <th style="width: 3rem;"></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var mod in ctx.Mods)
                {
                    var draggable = _isAdmin && ctx.AllowDrag;
                    <tr @key="mod.Id"
                        draggable="@(draggable ? "true" : "false")"
                        class="@(draggable ? "modlist-draggable" : null) @(ReferenceEquals(_dragged, mod) ? "modlist-dragging" : null)"
                        @ondragstart="() => OnDragStart(mod)"
                        @ondragenter="() => OnDragEnter(mod)"
                        @ondragover:preventDefault="true"
                        @ondrop="OnDropAsync"
                        @ondragend="OnDropAsync">
                        @if (_isAdmin)
                        {
                            <td>
                                @if (draggable)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small"
                                             Class="mud-text-secondary" Title="Drag to reorder" />
                                }
                            </td>
                            <td>
                                <MudCheckBox T="bool" Value="mod.IsActive"
                                             ValueChanged="@(v => SetActiveAsync(mod, v))"
                                             Color="Color.Primary" Dense="true" />
                            </td>
                        }
                        <td>
                            <MudLink Href="@WorkshopUrl(mod.WorkshopId)" Target="_blank">@mod.DisplayName</MudLink>
                            <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">@mod.WorkshopId</MudText>
                        </td>
                        <td>
                            @* Only the enabled ones, so this column matches what the export produces. *@
                            <MudText Typo="Typo.body2" Class="font-monospace">
                                @string.Join(", ", mod.PzModIds.Where(m => m.IsEnabled).Select(m => m.Value))
                            </MudText>
                        </td>
                        @if (_isAdmin)
                        {
                            <td>@string.Join(", ", mod.Requests.Select(r => r.RequesterName).Distinct())</td>
                        }
                        <td>
                            <MudText Typo="Typo.caption">@(mod.AddedToModlistAtUtc?.ToLocalTime().ToString("g"))</MudText>
                        </td>
                        @if (_isAdmin)
                        {
                            <td class="text-right">
                                <MudIconButton Size="Size.Small"
                                               Icon="@(IsExpanded(mod.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                               OnClick="@(() => ToggleExpanded(mod.Id))"
                                               aria-label="@(IsExpanded(mod.Id) ? "Hide details" : "Show details")" />
                            </td>
                        }
                    </tr>

                    @if (_isAdmin)
                    {
                        @* MudCollapse rather than MudExpansionPanel: the trigger is the button in the
                           row above, and an expansion panel would insist on rendering its own header. *@
                        <tr class="modlist-details-row">
                            <td colspan="7" class="pa-0">
                                <MudCollapse Expanded="@IsExpanded(mod.Id)">
                                    <div class="pa-4" style="background-color: var(--mud-palette-background-grey);">
                                        <ModDetailsPanel Mod="mod" OnChanged="OnDetailsChangedAsync" />
                                    </div>
                                </MudCollapse>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </MudSimpleTable>
    </div>;

    ModTable = (mods, allowDrag) => modTable((mods, allowDrag));
}

@if (_activeMods is null || _disabledMods is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (_activeMods.Count == 0)
    {
        <MudAlert Severity="Severity.Normal" Dense="true">No mods running for @_selectedGame yet.</MudAlert>
    }
    else
    {
        @ModTable(_activeMods, true)
    }

    @if (_disabledMods.Count > 0)
    {
        <MudText Typo="Typo.h6" Class="mt-8">Temporarily disabled</MudText>
        <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
            Approved and still downloaded by the server, but not currently loaded.
        </MudText>

        @ModTable(_disabledMods, false)
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<string> _games = [Mod.DefaultGame];
    private string _selectedGame = Mod.DefaultGame;
    private List<Mod>? _activeMods;
    private List<Mod>? _disabledMods;
    private string? _copiedMessage;
    private bool _copyFailed;
    private bool _isAdmin;
    private IJSObjectReference? _clipboardModule;
    private readonly HashSet<int> _expandedMods = [];
    private Mod? _dragged;
    private List<int> _orderAtDragStart = [];

    /// <summary>Renders one of the two lists; assigned from the markup above.</summary>
    private Func<List<Mod>, bool, RenderFragment> ModTable = default!;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await IsAdminAsync();

        var distinctGames = await ModRequestService.GetDistinctGamesAsync();
        if (distinctGames.Count > 0)
        {
            _games = distinctGames;
            if (!_games.Contains(_selectedGame))
            {
                _selectedGame = _games[0];
            }
        }

        await RefreshAsync();
    }

    private async Task<IJSObjectReference> GetClipboardModuleAsync() =>
        _clipboardModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/clipboard.js");

    // Two lists for everyone now: what's running, and what's approved but switched off. The split is
    // done by the queries rather than by hiding rows, since the page is public.
    private async Task RefreshAsync()
    {
        _activeMods = await ModRequestService.GetModlistAsync(_selectedGame, activeOnly: true);
        _disabledMods = await ModRequestService.GetParkedModsAsync(_selectedGame);
    }

    /// <summary>A details-panel edit can change what the exports contain, so drop the stale "Copied!".</summary>
    private void OnDetailsChangedAsync() => _copiedMessage = null;

    private async Task<bool> IsAdminAsync()
    {
        if (AuthenticationStateTask is null)
        {
            return false;
        }

        var state = await AuthenticationStateTask;
        return state.User.Identity?.IsAuthenticated == true;
    }

    private async Task SetActiveAsync(Mod mod, bool isActive)
    {
        // The checkbox is only rendered inside AuthorizeView, but this page is public, so re-check
        // server-side rather than treating "we didn't draw the control" as the security boundary.
        if (!await IsAdminAsync())
        {
            return;
        }

        await ModRequestService.SetModActiveAsync(mod.Id, isActive);
        mod.IsActive = isActive;
        _copiedMessage = null;

        // Re-query so the row moves between the two lists straight away, rather than sitting in the
        // wrong one until the next page load.
        await RefreshAsync();
    }

    private async Task OnGameChangedAsync(string? game)
    {
        _selectedGame = game ?? Mod.DefaultGame;
        _copiedMessage = null;
        await RefreshAsync();
    }

    private async Task CopyWorkshopIdsAsync()
    {
        var ids = await ModRequestService.BuildApprovedWorkshopIdExportAsync();
        await CopyAsync(ids, "Nothing to copy yet.");
    }

    private async Task CopyZomboidModIdsAsync()
    {
        var ids = await ModRequestService.BuildApprovedZomboidModIdExportAsync();
        await CopyAsync(ids, "No approved Zomboid mod IDs to copy.");
    }

    private async Task CopyAsync(string payload, string emptyMessage)
    {
        try
        {
            var module = await GetClipboardModuleAsync();
            await module.InvokeVoidAsync("copyToClipboard", payload);
            _copyFailed = false;
            _copiedMessage = string.IsNullOrEmpty(payload) ? emptyMessage : "Copied!";
        }
        catch (JSException)
        {
            // Now that these buttons are public, a browser that blocks clipboard writes must not
            // take the whole circuit down with it - say so and leave the page working.
            _copyFailed = true;
            _copiedMessage = "Your browser blocked the copy. Check its clipboard permission for this site.";
        }
    }

    private void OnDragStart(Mod mod)
    {
        _dragged = mod;
        _orderAtDragStart = _activeMods?.Select(m => m.Id).ToList() ?? [];
    }

    /// <summary>
    /// Reorders live as the row is dragged over its neighbours, so the list previews where the mod
    /// will land. Nothing is saved until the drag finishes.
    /// </summary>
    private void OnDragEnter(Mod target)
    {
        if (_dragged is null || _activeMods is null || ReferenceEquals(_dragged, target))
        {
            return;
        }

        var from = _activeMods.IndexOf(_dragged);
        var to = _activeMods.IndexOf(target);
        if (from < 0 || to < 0)
        {
            return;
        }

        _activeMods.RemoveAt(from);
        _activeMods.Insert(to, _dragged);
    }

    /// <summary>
    /// Handles both drop and dragend - dragend also fires when the row is released somewhere that
    /// isn't a drop target, and without it a reorder previewed on screen would never be saved.
    /// </summary>
    private async Task OnDropAsync()
    {
        var dragged = _dragged;
        _dragged = null;

        if (dragged is null || _activeMods is null)
        {
            return;
        }

        var ids = _activeMods.Select(m => m.Id).ToList();
        if (ids.SequenceEqual(_orderAtDragStart))
        {
            return;
        }

        // Same reasoning as the other admin actions: this page is public, so re-check server-side.
        if (!await IsAdminAsync())
        {
            await RefreshAsync();
            return;
        }

        await ModRequestService.ReorderModlistAsync(ids);
        _orderAtDragStart = ids;
        _copiedMessage = null;
    }

    private bool IsExpanded(int modId) => _expandedMods.Contains(modId);

    private void ToggleExpanded(int modId)
    {
        if (!_expandedMods.Remove(modId))
        {
            _expandedMods.Add(modId);
        }
    }

    private static string WorkshopUrl(string workshopId) =>
        $"https://steamcommunity.com/sharedfiles/filedetails/?id={workshopId}";

    public async ValueTask DisposeAsync()
    {
        if (_clipboardModule is not null)
        {
            try
            {
                await _clipboardModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; nothing to dispose on the client.
            }
        }
    }
}
