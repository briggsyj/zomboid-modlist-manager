@page "/login"
@* Deliberately static (no @rendermode): a plain HTML form POSTs straight to the /account/login
   minimal API endpoint, which is the only place that can call HttpContext.SignInAsync. *@

<PageTitle>Login</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Login</MudText>

<MudCard Elevation="2" Style="max-width: 26rem;">
    <MudCardContent>
        @if (Error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">Incorrect password.</MudAlert>
        }

        <form method="post" action="/account/login">
            <MudTextField T="string" Label="Password" InputType="InputType.Password"
                          Variant="Variant.Outlined" Class="mb-4"
                          name="password" id="password" Required="true" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                Log in
            </MudButton>
        </form>
    </MudCardContent>
</MudCard>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}
