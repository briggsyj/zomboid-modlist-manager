@* Rendered inside the MudAppBar. The logout action stays a real form POST because signing out
   needs HttpContext, which an interactive circuit can't touch after the initial response.

   Routes are deliberately unchanged by the renames - /modlist and /admin still work, so existing
   links and bookmarks don't break. *@

<MudButton Href="/" Variant="Variant.Text" Color="Color.Inherit">Requests</MudButton>
<MudButton Href="backlog" Variant="Variant.Text" Color="Color.Inherit">Backlog</MudButton>
<MudButton Href="modlist" Variant="Variant.Text" Color="Color.Inherit">Active Mods</MudButton>
<AuthorizeView Context="adminNav">
    <Authorized>
        <MudButton Href="admin" Variant="Variant.Text" Color="Color.Inherit">Manage</MudButton>
    </Authorized>
</AuthorizeView>

<MudSpacer />

<AuthorizeView>
    <Authorized>
        <form method="post" action="/account/logout" class="d-inline">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit">Log out</MudButton>
        </form>
    </Authorized>
    <NotAuthorized>
        <MudButton Href="login" Variant="Variant.Text" Color="Color.Inherit">Login</MudButton>
    </NotAuthorized>
</AuthorizeView>
