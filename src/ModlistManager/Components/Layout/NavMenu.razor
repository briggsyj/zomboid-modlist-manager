@* Rendered inside the MudAppBar. The logout action stays a real form POST because signing out
   needs HttpContext, which an interactive circuit can't touch after the initial response. *@

<MudButton Href="" Variant="Variant.Text" Color="Color.Inherit">Requests</MudButton>
<MudButton Href="modlist" Variant="Variant.Text" Color="Color.Inherit">Modlist</MudButton>

<MudSpacer />

<AuthorizeView>
    <Authorized>
        <MudButton Href="admin" Variant="Variant.Text" Color="Color.Inherit">Admin</MudButton>
        <form method="post" action="/account/logout" class="d-inline">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit">Log out</MudButton>
        </form>
    </Authorized>
    <NotAuthorized>
        <MudButton Href="login" Variant="Variant.Text" Color="Color.Inherit">Admin login</MudButton>
    </NotAuthorized>
</AuthorizeView>
